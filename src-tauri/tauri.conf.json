{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stereo Wizard",
  "version": "0.1.0",
  "identifier": "dev.rafael.stereo-wizard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stereo Wizard \u2014 Discord Voice",
        "width": 600,
        "height": 620,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/StereoWizardIcon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}