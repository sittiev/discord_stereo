# Stereo Wizard report sinks - all optional; copy to .env and fill.
# .env is gitignored; these values are secrets and never enter the repo.

# Discord webhook that receives divergence reports (compile-time via
# cargo, or runtime env when launching the app).
STEREO_WEBHOOK=

# GitHub personal access token (issues:write) - posts each divergence
# report as an issue on the project repo. Env-only, never compiled in.
STEREO_GH_TOKEN=
